{
  "name": "@codex-bridge/dsh-desktop-connector",
  "version": "1.0.0",
  "description": "Connect Codex Bridge to native DeepSeek Harness Desktop sessions",
  "type": "module",
  "main": "index.mjs",
  "exports": { ".": "./index.mjs", "./client": "./client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-renderer"],
      "external": ["@deepseek-ai/dsh-client-ui-workspace/client", "@deepseek-ai/dsh-client-ui-renderer/client", "@deepseek-ai/dsh-client-connection/client", "react"]
    }
  },
  "peerDependencies": { "@deepseek-ai/schemastery": "3.18.4", "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2", "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2" },
  "files": ["*.mjs", "client.js", "cordis.patch.yml"]
}
